<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Damit der Builder die fertige APK direkt zur Installation anbieten kann -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="HTML APK Builder"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ProjectsActivity"
            android:exported="false"
            android:label="Meine Projekte" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CropActivity"
            android:exported="false"
            android:label="Icon zuschneiden" />

        <activity
            android:name=".InfoActivity"
            android:exported="false"
            android:label="Info" />

        <provider
            android:name=".OutputProvider"
            android:authorities="de.htmlapk.builder.output"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
